block S {}

circuit S {
    // Every field is named, a step's or a sweep's levels too.
    let a = Step { from: 5mA, to: 30mA, edge: 1us, at: 50us };
    let b = Step { on: vdd.i, from: 5mA, to: 30mA, edge: 1us };
    let c = Sweep { from: 4.5V, to: 3.0V, step: 10mV };
    // Named generic arguments: `< IDENT =` starts them, so `<` is less-than anywhere
    // else. Each value ends at `>`, so a comparison in one needs parentheses.
    let d = GainStage<A = Mcp6001> { vin: sensor, gnd };
    let e = GainStage<A = Mcp6001, GAIN = 2 * 10,> {};
    let f = G<N = (a > b)> {};
    let g = x < y;
    // A string is a value; its escapes are kept as written.
    let h = Note { text: "a \"quoted\" \\ word", empty: "" };
}
