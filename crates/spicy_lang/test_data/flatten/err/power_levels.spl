// Sources are counted per level (model.md §9, pass 8). Two regulators behind one
// supply's `v5` meet inside `Double`, and are reported there; two supplies on one net
// meet on the board. At one level each port counts: `Dual`'s two outputs on `seven`
// are two sources (as KiCad, Modelica and atopile count them).
block Reg { input: Power<In>, out: Power<Out>, gnd: Ground }

circuit Reg {
    let r = Resistor { a: input, b: out, value: 10 };
}

block Double { input: Power<In>, v5: Power<Out>, gnd: Ground }

circuit Double {
    let reg = Reg { input, out: v5, gnd };
    let reg2 = Reg { input, out: v5, gnd };
}

block Single { input: Power<In>, v5: Power<Out>, gnd: Ground }

circuit Single {
    let reg = Reg { input, out: v5, gnd };
}

block Dual { input: Power<In>, o1: Power<Out>, o2: Power<Out>, gnd: Ground }

circuit Dual {
    let reg1 = Reg { input, out: o1, gnd };
    let reg2 = Reg { input, out: o2, gnd };
}

block Board { v12: Power<In>, gnd: Ground }

circuit Board {
    net five;
    net six;
    net seven;
    let double = Double { input: v12, v5: five, gnd };
    let r = Resistor { a: five, b: gnd, value: 1k };
    let one = Single { input: v12, v5: six, gnd };
    let two = Single { input: v12, v5: six, gnd };
    let r2 = Resistor { a: six, b: gnd, value: 1k };
    let dual = Dual { input: v12, o1: seven, o2: seven, gnd };
    let r3 = Resistor { a: seven, b: gnd, value: 1k };
}
