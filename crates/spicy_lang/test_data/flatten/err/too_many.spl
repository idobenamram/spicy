circuit L8 {
    let a = L7 { p, g };
    let b = L7 { p, g };
    let c = L7 { p, g };
    let d = L7 { p, g };
}

block L9 { p: Pin, g: Ground }

circuit L9 {
    let a = L8 { p, g };
    let b = L8 { p, g };
    let c = L8 { p, g };
    let d = L8 { p, g };
}

block L10 { p: Pin, g: Ground }

circuit L10 {
