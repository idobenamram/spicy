// A problem inside a block is reported once, where it's written, however many
// placements have it (model.md E23), under one root or several.
block Load { vcc: Power<In>, gnd: Ground }

circuit Load {
    let r = Resistor { a: vcc, b: gnd, value: 1k };
}

block Mid { gnd: Ground }

circuit Mid {
    net rail;
    net x;
    net y;
    let load = Load { vcc: rail, gnd };
    let island = Resistor { a: x, b: y, value: 1k };
    let short = Resistor { a: gnd, b: gnd, value: 1k };
}

block One { gnd: Ground }

circuit One {
    let a = Mid { gnd };
    let b = Mid { gnd };
}

block Two { gnd: Ground }

circuit Two {
    let c = Mid { gnd };
}
