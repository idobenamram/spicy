// Amp is placed before it's defined, and `sig`, `out` and `base` are used before
// their `net` lines (model.md E4). `gnd` is shorthand for `gnd: gnd`.
block Top { v12: Power<In>, gnd: Ground }

circuit Top {
    let amp = Amp { vcc: v12, gnd, input: sig, output: out };
    net sig;
    net out;
}

block Amp { vcc: Power<In>, gnd: Ground, input: Analog<In>, output: Analog<Out> }

circuit Amp {
    let r = Resistor { a: vcc, b: output, value: 4k7 };
    let c = Capacitor { a: input, b: base, value: 100nF ± 10% };
    net base;
    let q = Npn { c: output, b: base, e: gnd };
}
