// A cycle below the roots (model.md E14): the roots aren't on it, so they're still
// roots. The search enters the cycle at `A`, reports `A → B → C → A` once, at `C`'s
// `let a`, and cuts only the cycle's three placements: each root keeps its own
// placement, and stops at the cut one below it.
block EnterA { g: Ground }

circuit EnterA {
    let a = A { g };
}

block EnterB { g: Ground }

circuit EnterB {
    let b = B { g };
}

block EnterC { g: Ground }

circuit EnterC {
    let c = C { g };
}

block A { g: Ground }

circuit A {
    let b = B { g };
}

block B { g: Ground }

circuit B {
    let c = C { g };
}

// The part before the placement: the placement that closes the cycle is `a`, not `r`.
block C { g: Ground }

circuit C {
    let r = Resistor { a: g, b: g, value: 1k };
    let a = A { g };
}
