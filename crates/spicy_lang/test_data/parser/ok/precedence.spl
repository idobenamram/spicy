contract P {
    // grammar.md §4.1: `within` loosest, then `..=`, then `±`, then arithmetic.
    assume x within 12V ± 5%;
    assume x within v - 0.5V..=v + 0.5V;
    spec a: y within (capacity / t) ± 10%;
    spec b: y within capacity / (t ± 10%);
    spec c: -3V + 1V <= 1V;
    spec d: vcc.v - dc(output.v) >= 2V;
    spec e: a * b + c / d - e < 1;
    spec f: y within r_nom ± 1%;
    spec g: y within vcc.v ± 50mV;
}
