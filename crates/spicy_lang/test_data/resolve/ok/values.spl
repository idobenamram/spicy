block Values { a: Pin, b: Pin }

circuit Values {
    let r1 = Resistor { a, b, value: 47k ± 1% };
    let r2 = Resistor { a, b, value: 4k7Ω };
    let r3 = Resistor { a, b, value: 2 * 4.7k };
    let r4 = Resistor { a, b, value: 1k + 2k };
    let r5 = Resistor { a, b, value: 10kohm ± 50 };
    let r6 = Resistor { a, b, value: (47k) };
    let r7 = Resistor { a, b, value: 100 / 2 };
    let c1 = Electrolytic { p: a, n: b, value: 1uF ± 20%, rating: 25V };
    let c2 = Capacitor { a, b, value: 22n ± 5% };
    let q1 = Npn { c: a, b, e: b, beta: 100..=300 };
    let q2 = Pnp { c: a, b, e: b, beta: 200 };
}
