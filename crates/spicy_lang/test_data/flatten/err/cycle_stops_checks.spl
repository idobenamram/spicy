// A root that places a cycle: the cycle is reported, and the root, cut short where the
// cycle closes, isn't checked as a whole. Checked, its `x` would be an isolated net.
block Board { g: Ground }

circuit Board {
    net x;
    let p = Ping { g, x };
}

block Ping { g: Ground, x: Pin }

circuit Ping {
    let pong = Pong { g, x };
}

block Pong { g: Ground, x: Pin }

circuit Pong {
    let ping = Ping { g, x };
}
