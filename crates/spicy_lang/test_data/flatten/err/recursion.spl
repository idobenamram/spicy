// A block can't contain itself (model.md E14). Each cycle is reported once, with its
// chain; a block placed twice on the way (a diamond) is not a cycle.
block Selfish {
    port g: Ground;
    let again = Selfish { g };
}

// `Ping` and `Pong` place each other: neither is unplaced, so neither is a root, and
// the cycle is still found.
block Ping {
    port g: Ground;
    let pong = Pong { g };
}

block Pong {
    port g: Ground;
    let ping = Ping { g };
}

block Diamond {
    port g: Ground;
    let left = Side { g };
    let right = Side { g };
}

block Side {
    port g: Ground;
    let leaf = Leaf { g };
}

block Leaf {
    port g: Ground;
}
