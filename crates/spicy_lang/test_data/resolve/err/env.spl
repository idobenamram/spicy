// An env is a range; a const is exact, and of a type the language knows.
env fixed: Temperature in 25°C;
env zero: Volt in 12V ± 0%;
env point: Volt in 5V..=5V;
const loose: Ohm = 10k ± 1%;
env warm: Temperatur in 20°C..=30°C;
const confidence: Confidence = 3;
env ambient: Temperature in -10°C..=60°C;
const ambient: Temperature = 25°C;
// A const can't name another yet, and an env isn't a number.
const A: Ohm = 1k;
const B: Ohm = A;
// A plain-number const can't say whether it's relative, so it isn't a tolerance yet.
const TOL: f64 = 1%;

block X { p: Pin, n: Pin }

circuit X {
    let r = Resistor { a: p, b: n, value: ambient };
    let r2 = Resistor { a: p, b: n, value: 1k ± TOL };
}

// A part reading a broken const isn't reported again, but its block is broken too.
block Y { p: Pin, n: Pin }

circuit Y {
    let r = Resistor { a: p, b: n, value: loose };
}

// An env written without a spread needs one, even when its type is wrong.
env typo: Temperatur in 25°C;
