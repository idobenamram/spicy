// A setup's name is given once per block, and the block after `for` is one of the file's.
block A { p: Pin }

circuit A {}

block B { p: Pin }

circuit B {}

setup S for A { p: Supply {} }

setup S for A { p: Supply {} }

// Each block names its own setups: this `S` is `B`'s, not a second `A`'s.
setup S for B { p: Supply {} }

setup T for Nowhere {}
