block Stereo {
    v12: Power<In>,
    gnd: Ground,
    left_in: Analog<In>,
    right_in: Analog<In>,
    left_out: Analog<Out>,
    right_out: Analog<Out>,
}

circuit Stereo {
    let left  = Stage { vcc: v12, gnd, input: left_in,  output: left_out };
    let right = Stage { vcc: v12, gnd, input: right_in, output: right_out };
}

block Stage { vcc: Power<In>, gnd: Ground, input: Analog<In>, output: Analog<Out> }

circuit Stage {
    let r = Resistor { a: input, b: output, value: 10k ± 1% };
}
