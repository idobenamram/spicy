contract Amp
  setup = Operating
  let h: response = ac(output.v / input.v)
  let gain: number = h.at(1000 Hz).mag()
  spec gain: gain within 4.6 ± 5%
  spec output: dc(output.v) within 5.5 V (4.5 V..=6.5 V)
  spec level: h.at(1000 Hz).db() >= 12 dB
  spec bass: h.f_low(-3 dB) <= 30 Hz
  spec treble: h.f_high(-3 dB, ref: dc) >= 20000 Hz
  spec headroom: dc(vcc.v - output.v) >= 4 V
  spec swing: dc(output.v) <= 7 V
  pub spec input_gain: ac(output.v / input.v).at(10000 Hz).mag() >= 3
const MAX_SWING 136..145 = 7 V
setup Operating 496..505 for Amp
  vcc: Supply v = 12 V
  input: Signal v = 0 V
  output: Load
  temp = 298.15 K (25 °C)
