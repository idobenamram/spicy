// Innermost is per port (model.md §9, pass 8): a placed block's port passes power on
// only from what's behind that port, inside the block.
// - `Dual`'s `o1` has nothing behind it, so it's a source of its own, and meets the
//   regulator behind `o2` on `seven`: two outputs of one block, as KiCad, Modelica and
//   atopile count them. The first source is where `o1` comes in, not `o2`.
// - `Tied` joins its two outputs inside, with nothing behind them: one net inside, one
//   source on `eight`, and nothing is reported.
// - `Pass`'s `b` has nothing behind it, so it's a load of its own, listed with the load
//   behind `a`.
// - A load behind a plain `Pin` is reported where the pin is bound (`p: line`), in the
//   block whose net it is, not inside `Plain`.
// - Three regulators on `bus` meet in one placement: one problem, at the second, that
//   lists all three (as atopile lists every source), not one problem per regulator.
block Reg {
    port input: Power<In>;
    port out: Power<Out>;
    port gnd: Ground;
    let r = Resistor { a: input, b: out, value: 10 };
}

block Load {
    port vcc: Power<In>;
    port gnd: Ground;
    let r = Resistor { a: vcc, b: gnd, value: 1k };
}

block Dual {
    port input: Power<In>;
    port o1: Power<Out>;
    port o2: Power<Out>;
    port gnd: Ground;
    let reg = Reg { input, out: o2, gnd };
    let r = Resistor { a: o1, b: gnd, value: 1k };
}

block Tied {
    port o1: Power<Out>;
    port o2: Power<Out>;
    port gnd: Ground;
    net both = [o1, o2];
    let r = Resistor { a: both, b: gnd, value: 1k };
}

block Pass {
    port a: Power<In>;
    port b: Power<In>;
    port gnd: Ground;
    let inner = Load { vcc: a, gnd };
    let r = Resistor { a: b, b: gnd, value: 1k };
}

block Plain {
    port p: Pin;
    port gnd: Ground;
    let load = Load { vcc: p, gnd };
}

block Board {
    port v12: Power<In>;
    port gnd: Ground;
    net seven;
    net eight;
    net rail;
    net line;
    net bus;
    let dual = Dual { input: v12, o1: seven, o2: seven, gnd };
    let tied = Tied { o1: eight, o2: eight, gnd };
    let load = Load { vcc: eight, gnd };
    let pass = Pass { a: rail, b: rail, gnd };
    let plain = Plain { p: line, gnd };
    let r1 = Reg { input: v12, out: bus, gnd };
    let r2 = Reg { input: v12, out: bus, gnd };
    let r3 = Reg { input: v12, out: bus, gnd };
}
