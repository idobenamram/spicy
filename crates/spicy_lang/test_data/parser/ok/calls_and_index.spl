    let a = h.f_high(-3dB, ref: dc);
    let c = f(x: 1, 2, y,);
    // `m[s]` is measure `m` in setup `s`: a postfix, like `.f` and `(…)`.
    let d = ac(out.v)[dm].at(60Hz).mag();
    let e = (mcu.code[full] - mcu.code[zero]) / 100mV;
    let g = a[b][c + 1];
    let k = -m[s];
}
