// Three levels: the outermost name survives, and every inner name is an alias.
block Amp {
    port vcc: Power<In>;
    port gnd: Ground;
    let r = Resistor { a: vcc, b: gnd, value: 1k ± 5% };
}

block Stage {
    port v12: Power<In>;
    port gnd: Ground;
    let left = Amp { vcc: v12, gnd };
}

block Board {
    port rail: Power<In>;
    port gnd: Ground;
    let s = Stage { v12: rail, gnd };
}
