// An item left open ends at the next item, which is read as usual.
block A { a: Pin,

circuit A {
    net n;

contract A {
    spec s: x within 1..=2;
}

// `setup =` and `pub spec` don't end a contract, but a `setup` item does.
contract B {
    setup = S;
    pub spec s: x within 1..=2;

setup S for B {}
