// A root too large to flatten (the limit is a million placements): each level places
// the one below four times, so 11 short blocks make 4^10 placements at the bottom.
// Reported at the placement that goes over, and `L10` isn't flattened.
block L0 { p: Pin, g: Ground }

circuit L0 {
    let r = Resistor { a: p, b: g, value: 1k };
}

block L1 { p: Pin, g: Ground }

circuit L1 {
    let a = L0 { p, g };
    let b = L0 { p, g };
    let c = L0 { p, g };
    let d = L0 { p, g };
}

block L2 { p: Pin, g: Ground }

circuit L2 {
    let a = L1 { p, g };
    let b = L1 { p, g };
    let c = L1 { p, g };
    let d = L1 { p, g };
}

block L3 { p: Pin, g: Ground }

circuit L3 {
    let a = L2 { p, g };
    let b = L2 { p, g };
    let c = L2 { p, g };
    let d = L2 { p, g };
}

block L4 { p: Pin, g: Ground }

circuit L4 {
    let a = L3 { p, g };
    let b = L3 { p, g };
    let c = L3 { p, g };
    let d = L3 { p, g };
}

