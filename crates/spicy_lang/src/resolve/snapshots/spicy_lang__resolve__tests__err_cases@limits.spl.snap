  spec open_bottom: dc(output.v) <invalid>
  spec range_at_most: dc(output.v) <invalid>
  spec volts_on_hertz: h.f_low(-3 dB) <invalid>
  spec kilo: h.f_high(-3 dB) <invalid>
  spec both: dc(output.v) <invalid>
  spec chained: <invalid> <invalid>
  spec open_amps: dc(output.v) <invalid>
  spec one_kilo: h.f_low(-3 dB) <invalid>
  spec no_width: dc(output.v) <invalid>
  spec broken_open: <invalid> <invalid>
  spec broken_one: <invalid> <invalid>
setup Operating 457..466 for Amp
  vcc: Supply v = 12 V
  input: Signal v = 0 V
  output: Load
  temp = 298.15 K (25 °C)

